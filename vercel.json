{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
      "app": {
        "root": ".",
        "framework": "express"
      },
      "client": {
        "root": "client",
        "framework": "vite"
      }
    },
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": {
          "service": "app"
        }
      },
      {
        "source": "/(.*)",
        "destination": {
          "service": "client"
        }
      }
    ]
  }